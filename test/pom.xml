	<profiles>
		<profile>
			<id>prepare-tests</id>
			<activation>
				<property>
					<name>!skipTests</name>
				</property>
			</activation>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<version>2.9</version>
						<executions>
							<execution>
								<!-- In continuous integration this has a tendency to timeout, so 
									try to get it twice -->
								<id>resolve-geoserver</id>
								<goals>
									<goal>get</goal>
								</goals>
								<phase>pre-integration-test</phase>
								<configuration>
									<artifact>
										org.geoserver.web:gs-web-app:${geoserver.version}:war
									</artifact>
									<remoteRepositories>osgeo-release::::https://repo.osgeo.org/repository/release/</remoteRepositories>
									<transitive>false</transitive>
								</configuration>
							</execution>
							<execution>
								<id>unpack-wars</id>
								<goals>
									<goal>unpack</goal>
								</goals>
								<phase>pre-integration-test</phase>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>org.geoserver.web</groupId>
											<artifactId>gs-web-app</artifactId>
											<version>${geoserver.version}</version>
											<type>war</type>
											<overWrite>true</overWrite>
											<outputDirectory>${project.build.directory}/geoserver
											</outputDirectory>
											<excludes>
												**/commons-dbcp-1.4.jar,**/*-SNAPSHOT.jar,**/*20140915*.jar,**/guava*.jar
											</excludes>
										</artifactItem>
									</artifactItems>
								</configuration>
							</execution>
							<execution>
								<id>setup-hbase</id>
								<goals>
									<goal>copy</goal>
								</goals>
								<phase>pre-integration-test</phase>
								<configuration>
									<artifactItems>
										<artifactItem>
											<artifactId>guava</artifactId>
											<groupId>com.google.guava</groupId>
											<version>${hbaseguava.version}</version>
										</artifactItem>
										<artifactItem>
											<artifactId>protobuf-java</artifactId>
											<groupId>com.google.protobuf</groupId>
											<version>${hbaseprotobuf.version}</version>
										</artifactItem>
										<artifactItem>
											<artifactId>hbase-client</artifactId>
											<groupId>org.apache.hbase</groupId>
										</artifactItem>
										<artifactItem>
											<artifactId>hbase-protocol</artifactId>
											<groupId>org.apache.hbase</groupId>
										</artifactItem>
									</artifactItems>
									<outputDirectory>${project.build.directory}/hbase/lib
									</outputDirectory>
								</configuration>
							</execution>
							<execution>
								<id>setup-wps</id>
								<goals>
									<goal>copy</goal>
								</goals>
								<phase>pre-integration-test</phase>
								<configuration>
									<artifactItems>
										<artifactItem>
											<groupId>org.geoserver.extension</groupId>
											<artifactId>gs-web-wps</artifactId>
											<version>${geoserver.version}</version>
											<overWrite>true</overWrite>
											<outputDirectory>
												${project.build.directory}/geoserver/WEB-INF/lib
											</outputDirectory>
										</artifactItem>
										<artifactItem>
											<groupId>org.geoserver.extension</groupId>
											<artifactId>gs-wps-core</artifactId>
											<version>${geoserver.version}</version>
											<overWrite>true</overWrite>
											<outputDirectory>
												${project.build.directory}/geoserver/WEB-INF/lib
											</outputDirectory>
										</artifactItem>
										<artifactItem>
											<groupId>org.geotools</groupId>
											<artifactId>gt-process-geometry</artifactId>
											<version>${geotools.version}</version>
											<overWrite>true</overWrite>
											<outputDirectory>
												${project.build.directory}/geoserver/WEB-INF/lib
											</outputDirectory>
										</artifactItem>
										<artifactItem>
											<groupId>org.geotools.xsd</groupId>
											<artifactId>gt-xsd-wps</artifactId>
											<version>${geotools.version}</version>
											<overWrite>true</overWrite>
											<outputDirectory>
												${project.build.directory}/geoserver/WEB-INF/lib
											</outputDirectory>
										</artifactItem>
										<artifactItem>
											<groupId>org.geotools.ogc</groupId>
											<artifactId>net.opengis.wps</artifactId>
											<version>${geotools.version}</version>
											<overWrite>true</overWrite>
											<outputDirectory>
												${project.build.directory}/geoserver/WEB-INF/lib
											</outputDirectory>
										</artifactItem>
										<artifactItem>
											<groupId>xalan</groupId>
											<artifactId>serializer</artifactId>
											<version>2.7.1</version>
											<overWrite>true</overWrite>
											<outputDirectory>
												${project.build.directory}/geoserver/WEB-INF/lib
											</outputDirectory>
										</artifactItem>
									</artifactItems>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-resources-plugin</artifactId>
						<version>3.0.2</version>
						<executions>
							<execution>
								<id>copy-resources</id>
								<phase>pre-integration-test</phase>
								<goals>
									<goal>copy-resources</goal>
								</goals>
								<configuration>
									<outputDirectory>${project.build.directory}/restservices
									</outputDirectory>
									<resources>
										<resource>
											<directory>
												${project.basedir}/../services/rest/src/main/webapp
											</directory>
										</resource>
									</resources>
								</configuration>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-failsafe-plugin</artifactId>
						<version>3.6.0</version>
						<executions>
							<execution>
								<configuration>
									<systemPropertyVariables>
										<zookeeperUrl>${zookeeperUrl}</zookeeperUrl>
										<instance>${instance}</instance>
										<username>${username}</username>
										<password>${password}</password>
										<testStoreType>${testStoreType}</testStoreType>
										<testStoreOptions>${testStoreOptions}</testStoreOptions>
										<testServerEnabled>${testServerEnabled}</testServerEnabled>
										<geoserver.version>${geoserver.version}</geoserver.version>
										<log4j.configurationFile>
											file:${project.build.testOutputDirectory}/log4j-test.properties
										</log4j.configurationFile>
										<java.util.logging.config.file>
											${project.build.testOutputDirectory}/jul-test.properties
										</java.util.logging.config.file>
									</systemPropertyVariables>
									<!-- Sonar currently just supports surefire so "trick" Sonar into 
										thinking they are surefire reports -->
									<reportsDirectory>${surefire.report.path}
									</reportsDirectory>
									<argLine>${test.args} ${it.jvm.args} ${jacoco.failsafe.argline}</argLine>
									<environmentVariables>
										<JAVA_TOOL_OPTIONS>${it.child.jvm.options}</JAVA_TOOL_OPTIONS>
									</environmentVariables>
									<excludes>
										<exclude>**/*IT.java</exclude>
									</excludes>
									<includes>
										<include>**/*ITSuite.java</include>
									</includes>
								</configuration>
								<goals>
									<goal>integration-test</goal>
									<goal>verify</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
					<plugin>
						<artifactId>maven-antrun-plugin</artifactId>
						<version>1.7</version>
						<dependencies>
							<dependency>
								<groupId>org.jacoco</groupId>
								<artifactId>org.jacoco.ant</artifactId>
								<version>${jacoco.version}</version>
							</dependency>
						</dependencies>
						<executions>
							<execution>
								<phase>post-integration-test</phase>
								<configuration>
									<tasks xmlns:jacoco="antlib:org.jacoco.ant">
										<mkdir dir="${project.reporting.outputDirectory}" />
										<taskdef uri="antlib:org.jacoco.ant" resource="org/jacoco/ant/antlib.xml" classpathref="maven.plugin.classpath" />
										<jacoco:report>
											<executiondata>
												<fileset dir="../" includes="**/coverage-reports/*.exec" />
											</executiondata>

											<structure name="GeoWave">
												<classfiles>
													<fileset dir="../" includes="**/target/classes/**" />
												</classfiles>
												<sourcefiles>
													<fileset dir="../" includes="**/src/main/java/**,**/src/main/scala/**" />
												</sourcefiles>
											</structure>

											<xml destfile="${project.reporting.outputDirectory}/jacoco.xml" />
										</jacoco:report>
									</tasks>
								</configuration>
								<goals>
									<goal>run</goal>
