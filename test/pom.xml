	<properties>
		<skipITs>true</skipITs>
		<!-- Passed to the IT JVM as JAVA_TOOL_OPTIONS, which the JVM reads before the
			command line and which ProcessBuilder hands on to any JVM it launches. Empty
			except on the Accumulo lanes.

			MiniAccumuloClusterImpl hard-codes -XX:+UseConcMarkSweepGC and
			-XX:CMSInitiatingOccupancyFraction=75 into the command line of every JVM it
			launches, as an array literal with no configuration hook. CMS was removed in JDK
			14, so on 21 each child dies with "Unrecognized VM option 'UseConcMarkSweepGC'"
			before it runs, and the cluster reports only "Initialize process returned 1" with
			the real error in a child log that never reaches the build output.
			IgnoreUnrecognizedVMOptions is read first and makes the dead flags survivable.
			Accumulo 2.1 dropped them, so this goes away with 4.2's bump. -->
		<it.child.jvm.options />
		<!-- Extra arguments for the IT JVM itself, set per lane. Empty except on cassandra-it. -->
		<it.jvm.args />
	</properties>
