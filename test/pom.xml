			<id>cassandra-it</id>
			<properties>
				<skipITs>false</skipITs>
				<testStoreType>CASSANDRA</testStoreType>
				<!-- Cassandra sizes every prepared statement with jamm before caching it
					(QueryProcessor.storePreparedStatement -> ObjectSizes.measureDeep). Loaded as a
					java agent, as cassandra-env.sh always does, jamm measures through
					Instrumentation. Embedded without one it falls back to
					Unsafe.objectFieldOffset, which throws "can't get field offset on a hidden
					class" for the lambdas in ClusteringComparator on JDK 15+, so the first
					PREPARE of any statement fails. The jar path is set by dependency:properties
					below, which resolves it from the graph rather than pinning a version. -->
				<it.jvm.args>-javaagent:${com.github.jbellis:jamm:jar}</it.jvm.args>
			</properties>
			<build>
				<plugins>
					<plugin>
						<groupId>org.apache.maven.plugins</groupId>
						<artifactId>maven-dependency-plugin</artifactId>
						<executions>
							<execution>
								<id>locate-jamm</id>
								<goals>
									<goal>properties</goal>
								</goals>
							</execution>
						</executions>
					</plugin>
				</plugins>
			</build>
