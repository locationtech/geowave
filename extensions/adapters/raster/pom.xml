<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
	<modelVersion>4.0.0</modelVersion>
	<parent>
		<artifactId>geowave-extension-parent</artifactId>
		<groupId>org.locationtech.geowave</groupId>
		<relativePath>../../</relativePath>
		<version>3.0.0-SNAPSHOT</version>
	</parent>
	<artifactId>geowave-adapter-raster</artifactId>
	<name>Geowave Raster Adapter</name>
	<description>Geowave Data Adapter for Raster Data</description>
	<dependencies>
		<dependency>
			<groupId>com.google.protobuf</groupId>
			<artifactId>protobuf-java</artifactId>
		</dependency>
		<dependency>
			<groupId>it.geosolutions.imageio-ext</groupId>
			<artifactId>imageio-ext-gdalgeotiff</artifactId>
		</dependency>
		<dependency>
			<groupId>org.geotools</groupId>
			<artifactId>gt-imageio-ext-gdal</artifactId>
		</dependency>
		<dependency>
			<groupId>me.lemire.integercompression</groupId>
			<artifactId>JavaFastPFOR</artifactId>
			<version>0.1.12</version>
		</dependency>
		<dependency>
			<groupId>com.google.guava</groupId>
			<artifactId>guava</artifactId>
		</dependency>
		<dependency>
			<groupId>org.apache.commons</groupId>
			<artifactId>commons-math3</artifactId>
		</dependency>
		<dependency>
			<groupId>net.lingala.zip4j</groupId>
			<artifactId>zip4j</artifactId>
			<version>1.3.2</version>
		</dependency>
		<dependency>
			<groupId>org.codehaus.plexus</groupId>
			<artifactId>plexus-archiver</artifactId>
			<version>2.2</version>
		</dependency>
		<dependency>
			<groupId>org.locationtech.geowave</groupId>
			<artifactId>geowave-adapter-auth</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.locationtech.geowave</groupId>
			<artifactId>geowave-core-mapreduce</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.locationtech.geowave</groupId>
			<artifactId>geowave-core-geotime</artifactId>
			<version>${project.version}</version>
		</dependency>
		<dependency>
			<groupId>org.geotools</groupId>
			<artifactId>gt-api</artifactId>
		</dependency>
		<dependency>
			<groupId>org.geotools</groupId>
			<artifactId>gt-main</artifactId>
		</dependency>
		<dependency>
			<groupId>org.geotools</groupId>
			<artifactId>gt-wps</artifactId>
		</dependency>
		<dependency>
			<groupId>org.geoserver</groupId>
			<artifactId>gs-wms-core</artifactId>
			<exclusions>
				<exclusion>
					<artifactId>gt-epsg-hsql</artifactId>
					<groupId>org.geotools</groupId>
				</exclusion>
				<exclusion>
					<groupId>log4j</groupId>
					<artifactId>log4j</artifactId>
				</exclusion>
				<exclusion>
					<groupId>commons-beanutils</groupId>
					<artifactId>commons-beanutils</artifactId>
				</exclusion>
			</exclusions>
		</dependency>
		<dependency>
			<groupId>org.geotools</groupId>
			<artifactId>gt-render</artifactId>
		</dependency>
		<dependency>
			<groupId>org.geotools</groupId>
			<artifactId>gt-epsg-wkt</artifactId>
		</dependency>
	</dependencies>
	<build>
		<!-- HBase region servers decode tiles when they merge them, on their protobuf-java
			2.5.0 (see hbaseprotobuf.version), so the tile classes are generated by protoc
			2.5.0 and compiled against protobuf-java 2.5.0 rather than protobuf.version. Built
			that way they also run on protobuf-java 3.x; built against 3.x they call
			GeneratedMessage.Builder.addAll(Iterable, List), which 2.5.0 does not have. protoc
			is run directly: protobuf-maven-plugin passes protoc its arguments in an @argfile,
			which protoc only reads from 3.x on. -->
		<plugins>
			<plugin>
				<artifactId>maven-dependency-plugin</artifactId>
				<version>3.11.0</version>
				<executions>
					<execution>
						<id>copy-protoc</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>copy</goal>
						</goals>
						<configuration>
							<artifactItems>
								<artifactItem>
									<groupId>com.google.protobuf</groupId>
									<artifactId>protoc</artifactId>
									<version>${hbaseprotobuf.version}</version>
									<classifier>${hbaseprotoc.classifier}</classifier>
									<type>exe</type>
									<destFileName>protoc.exe</destFileName>
								</artifactItem>
								<artifactItem>
									<groupId>com.google.protobuf</groupId>
									<artifactId>protobuf-java</artifactId>
									<version>${hbaseprotobuf.version}</version>
									<destFileName>protobuf-java.jar</destFileName>
								</artifactItem>
							</artifactItems>
							<outputDirectory>${project.build.directory}/protoc</outputDirectory>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<artifactId>maven-antrun-plugin</artifactId>
				<version>3.2.0</version>
				<executions>
					<execution>
						<id>generate-protobuf</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<property name="protoc" location="${project.build.directory}/protoc/protoc.exe" />
								<property name="generated" location="${project.build.directory}/generated-sources/protobuf" />
								<delete dir="${generated}" />
								<mkdir dir="${generated}" />
								<chmod file="${protoc}" perm="u+x" />
								<apply executable="${protoc}" parallel="true" failonerror="true">
									<arg value="--proto_path=${project.basedir}/src/main/protobuf" />
									<arg value="--java_out=${generated}" />
									<fileset dir="${project.basedir}/src/main/protobuf" includes="*.proto" />
								</apply>
							</target>
						</configuration>
					</execution>
					<execution>
						<!-- Over the classes the compiler made of them against protobuf.version.
							Their own API is the same either way, so nothing that calls them needs
							recompiling. -->
						<id>compile-protobuf-against-hbase</id>
						<phase>process-classes</phase>
						<goals>
							<goal>run</goal>
						</goals>
						<configuration>
							<target>
								<!-- Into a directory of their own first: Ant's javac skips sources
									that are older than their classes. -->
								<property name="classes" location="${project.build.directory}/protobuf-classes" />
								<delete dir="${classes}" />
								<mkdir dir="${classes}" />
								<javac srcdir="${project.build.directory}/generated-sources/protobuf" destdir="${classes}" classpath="${project.build.directory}/protoc/protobuf-java.jar" release="${maven.compiler.target}" encoding="UTF-8" debug="true" nowarn="true" includeantruntime="false" />
								<copy todir="${project.build.outputDirectory}" overwrite="true">
									<fileset dir="${classes}" />
								</copy>
							</target>
						</configuration>
					</execution>
				</executions>
			</plugin>
			<plugin>
				<groupId>org.codehaus.mojo</groupId>
				<artifactId>build-helper-maven-plugin</artifactId>
				<version>3.6.2</version>
				<executions>
					<execution>
						<id>add-protobuf-sources</id>
						<phase>generate-sources</phase>
						<goals>
							<goal>add-source</goal>
						</goals>
						<configuration>
							<sources>
								<source>${project.build.directory}/generated-sources/protobuf</source>
							</sources>
						</configuration>
					</execution>
				</executions>
			</plugin>
		</plugins>
	</build>
</project>
